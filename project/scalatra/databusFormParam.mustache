{{#isFormParam}}
        val {{paramName}} = Try(fileMultiParams("{{baseName}}").head).toOption
            .map(a => new String(a.get()))
            .orElse(multiParams("{{baseName}}").headOption)
        {{#required}}
            .getOrElse(halt(400, "Form parameter {{baseName}} not specified."))
        {{/required}}
{{/isFormParam}}